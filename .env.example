# Server Configuration
SERVER_PORT=8088

# MongoDB Configuration
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/health-bridge-dev?retryWrites=true&w=majority
SPRING_DATA_MONGODB_DATABASE=health-bridge-dev

# JWT Configuration
APP_JWT_SECRET=your_jwt_secret_key_here
APP_JWT_EXPIRATION_MS=86400000

# Mail Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
