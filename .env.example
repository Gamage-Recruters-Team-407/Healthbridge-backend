# MongoDB Atlas organization metadata (not used by the application runtime)
MONGODB_ATLAS_ORG_ID=6a1823c8bc5c1a384c2218ec

# Replace with the connection string from your Atlas cluster.
# Do not commit credentials or a real connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/health-bridge-dev?retryWrites=true&w=majority

# Application settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-a-local-development-secret
